<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Vimeo thumbnail test</title>

  <style>
    body {
      font-family: Arial, sans-serif;
      max-width: 900px;
      margin: 40px auto;
      padding: 0 20px;
    }

    .video-placeholder {
      position: relative;
      aspect-ratio: 16 / 9;
      background: #eee;
      overflow: hidden;
    }

    .video-placeholder img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .message {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .message span {
      background: white;
      padding: 15px 20px;
      font-weight: bold;
    }
  </style>
</head>

<body>

  <h1>Vimeo thumbnail test</h1>

  <p>
    This gets the thumbnail from Vimeo using oEmbed,
    without loading the Vimeo video player.
  </p>

  <div class="video-placeholder">

    <img
      id="vimeo-thumbnail"
      src=""
      alt="Vimeo video thumbnail"
    >

    <div class="message">
      <span>Accept cookies to play video</span>
    </div>

  </div>

  <script>

    // Change this to the Vimeo video you want to test
    const vimeoUrl = 'https://vimeo.com/286898202';


    // Vimeo oEmbed endpoint
    const oEmbedUrl =
      'https://vimeo.com/api/oembed.json?url=' +
      encodeURIComponent(vimeoUrl);


    // Ask Vimeo for information about the video
    fetch(oEmbedUrl)

      .then(response => {

        if (!response.ok) {
          throw new Error(
            'Vimeo oEmbed request failed: ' +
            response.status
          );
        }

        return response.json();

      })

      .then(data => {

        // Vimeo gives us the thumbnail URL
        console.log(
          'Vimeo thumbnail URL:',
          data.thumbnail_url
        );

        // Display the thumbnail
        document
          .getElementById('vimeo-thumbnail')
          .src = data.thumbnail_url;

      })

      .catch(error => {

        console.error(
          'Unable to retrieve Vimeo thumbnail:',
          error
        );

      });

  </script>

</body>
</html>
